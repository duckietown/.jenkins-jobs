    <concurrentBuild>false</concurrentBuild>
    <builders>
        <hudson.tasks.Shell>
            <command>set -e

select_builder() {
    for candidate in 172.27.0.43:2376 172.27.0.250:2376; do
        if docker --host "tcp://${candidate}" info &gt;/dev/null 2&gt;&amp;1; then
            echo "${candidate}"
            return 0
        fi
    done
    return 1
}

BUILDER="$(select_builder)"
if [ -z "${BUILDER}" ]; then
    echo "No reachable arm64v8 builder found."
    exit 1
fi

DOCKER_HOST="tcp://${BUILDER}"

docker --host "${DOCKER_HOST}" login --username liampaull --password "${DOCKER_PASSWORD}" docker.io

docker --host "${DOCKER_HOST}" build \
    --pull \
    --file Dockerfile \
    --tag duckietown/dt-px4:ente-arm64v8 \
    .

docker --host "${DOCKER_HOST}" push duckietown/dt-px4:ente-arm64v8
            </command>
            <configuredLocalRules/>
        </hudson.tasks.Shell>
